# Copy this file to `.env.local` and fill in real values.
# `.env.local` is auto-loaded in dev and is gitignored (never commit real secrets).

# ── Admin auth (REQUIRED in production) ───────────────────────────────────────
# The back-office uses per-USER accounts (email + scrypt-hashed password, managed
# in the Équipe module). These vars define the BOOTSTRAP Super Admin used to seed
# the very first account (and as the demo seeder's Super Admin). In production
# (NODE_ENV=production) the server refuses to start unless ADMIN_PASSWORD and
# ADMIN_SESSION_SECRET are set and long enough — there is no dev-default in prod.

# Bootstrap Super Admin email — the first login on a fresh install creates this
# Super Admin account. Defaults to admin@sakaneom.tn in dev.
ADMIN_EMAIL=admin@sakaneom.tn

# Bootstrap Super Admin password. Min 12 chars in production.
ADMIN_PASSWORD=change-me

# Secret used to encrypt the admin session cookie. Min 32 chars in production.
# Generate one with:  openssl rand -hex 24
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars

# ── Persistent storage (REQUIRED in production) ───────────────────────────────
# Where the JSON data store and uploaded images live. Point these at a PERSISTENT
# directory OUTSIDE the deploy/checkout dir so redeploys never wipe leads/content.
# In production (NODE_ENV=production) the server REFUSES to start unless BOTH are
# set — the dev defaults (./data and ./public/uploads) live inside the build dir
# and would be wiped on every redeploy. Dev still falls back to those defaults.
# Example (VPS):
# DATA_DIR=/var/lib/sakaneom/data
# UPLOAD_DIR=/var/lib/sakaneom/uploads

# ── Canonical site URL (SEO) ──────────────────────────────────────────────────
# Used for sitemap.xml / robots.txt (server) and canonical + OG image (client).
# Set BOTH to the public origin, no trailing slash. VITE_SITE_URL is inlined into
# the client bundle at build time, so it must be present when you run `bun run build`.
# SITE_URL=https://sakaneom.tn
# VITE_SITE_URL=https://sakaneom.tn
